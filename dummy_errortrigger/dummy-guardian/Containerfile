# Created with AI assistance (Claude Opus 5.5, Anthropic).
# Dummy Battery Thermal Guardian: reports the four Guardian faults to the DFM

# ---- Build stage ----
FROM docker.io/library/rust:1-bookworm AS build
RUN apt-get update && apt-get install -y --no-install-recommends clang libclang-dev git \
    && rm -rf /var/lib/apt/lists/*
# Same toolchain fault-lib pins
RUN rustup toolchain install nightly-2025-07-14 --profile minimal
WORKDIR /src
COPY Cargo.toml .
COPY src ./src
RUN cargo +nightly-2025-07-14 build --release

# ---- Runtime stage ----
FROM docker.io/library/debian:bookworm-slim
COPY --from=build /src/target/release/dummy-guardian /usr/local/bin/dummy-guardian
ENTRYPOINT ["/usr/local/bin/dummy-guardian"]
CMD ["scenario"]
