# Evidence collector: links injected fault, Guardian events and diagnostics into a verdict. (skeleton)
#   podman build -t localhost/evidence-collector:dev -f Containerfile .

# ---- Build stage ----
FROM docker.io/library/rust:1-bookworm AS build
WORKDIR /src
COPY Cargo.toml ./
COPY src src
RUN cargo build --release --bins

# ---- Runtime stage ----
FROM docker.io/library/debian:bookworm-slim
COPY --from=build /src/target/release/evidence-collector /usr/local/bin/
USER 65534:65534
ENTRYPOINT ["evidence-collector"]
