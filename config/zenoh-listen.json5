// Zenoh configuration for the Guardian (--zenoh-config): it listens on a fixed
// address, the other programs connect to it (zenoh-connect.json5). Use it
// when multicast discovery does not work (VPN, Wi-Fi, containers).
//
// 127.0.0.1 = all programs on the same machine (e.g. all containers in the
// AutoSD VM with --net=host). For programs on other machines, listen on
// "tcp/0.0.0.0:7447" instead and open port 7447/tcp.
{
  mode: "peer",
  listen: { endpoints: ["tcp/127.0.0.1:7447"] },
  scouting: { multicast: { enabled: false } },
}
