+// Bounded, not HAL_MAX_DELAY (unbounded): a transient I2C glitch used to be
+// able to hang these calls forever, freezing whichever thread/critical
+// section called them (and, if called while holding a shared mutex,
+// anything else waiting on it too).
+#define SSD1306_I2C_TIMEOUT_MS 100
