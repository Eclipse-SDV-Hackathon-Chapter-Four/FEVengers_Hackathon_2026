# Battery Thermal Guardian container image (Podman / Ankaios workload).
#   podman build -t battery-thermal-guardian -f Containerfile .
#   podman run --rm --net=host battery-thermal-guardian
#
# With DFM reporting (src/faults.rs, src/dfm.rs): the catalog directory is
# mounted (the same one the DFM uses) and passed with --dfm-catalog. fault-lib
# talks to the DFM over iceoryx2 shared memory, so the container needs the
# same IPC options as the DFM container and must run as the same user:
#   podman run --rm --net=host --ipc=host --pid=host --user 0:0 \
#     -v /dev/shm:/dev/shm -v /tmp/iceoryx2:/tmp/iceoryx2 -v <catalog dir>:/catalogs:ro \
#     battery-thermal-guardian --config /etc/guardian/guardian.toml \
#     --dfm-catalog /catalogs/battery_guardian_catalog.json
# On AutoSD (SELinux enforcing) also add --security-opt label=disable.

# ---- Build stage ----
# Full Rust toolchain; compiles all three binaries in release mode.
FROM docker.io/library/rust:1.99.0-bookworm AS build
# iceoryx2 (used by fault-lib) generates its POSIX bindings with bindgen,
# which needs libclang at build time.
RUN apt-get update && apt-get install -y --no-install-recommends clang libclang-dev \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /src
# Manifest and lock file first, then the sources.
COPY Cargo.toml Cargo.lock ./
COPY src src
# --locked: build exactly the dependency versions in Cargo.lock.
RUN cargo build --release --locked --bins

# ---- Runtime stage ----
# Small Debian image with only the binaries and the default configuration.
FROM docker.io/library/debian:bookworm-slim
# guardian = the service; guardian-monitor is a test tool that can be
# started from the same image with --entrypoint.
COPY --from=build /src/target/release/guardian /src/target/release/guardian-monitor /usr/local/bin/
COPY config/guardian.toml /etc/guardian/guardian.toml
# Run as "nobody"; override with --user when DFM reporting is used (see above).
USER 65534:65534
ENTRYPOINT ["guardian"]
CMD ["--config", "/etc/guardian/guardian.toml"]
