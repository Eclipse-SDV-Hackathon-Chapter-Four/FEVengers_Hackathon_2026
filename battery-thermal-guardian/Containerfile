# Battery Thermal Guardian container image (Podman / Ankaios workload).
#   podman build -t battery-thermal-guardian -f Containerfile .
#   podman run --rm --net=host battery-thermal-guardian
FROM docker.io/library/rust:1-bookworm AS build
WORKDIR /src
COPY Cargo.toml Cargo.lock ./
COPY src src
RUN cargo build --release --locked --bins

FROM docker.io/library/debian:bookworm-slim
COPY --from=build /src/target/release/guardian /src/target/release/vss-sim /src/target/release/guardian-monitor /usr/local/bin/
COPY config/guardian.toml /etc/guardian/guardian.toml
USER 65534:65534
ENTRYPOINT ["guardian"]
CMD ["--config", "/etc/guardian/guardian.toml"]
